# ------------------------------------------------------------------
# HAPR Visual — environment variables
# Copy this file to .env and fill in the values.
# ------------------------------------------------------------------

# PostgreSQL connection string (local: docker compose up -d db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haprvisual"

# NextAuth — required
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Admin login (Credentials provider)
ADMIN_EMAIL="admin@haprvisual.com"
ADMIN_PASSWORD="change-me-strong-password"

# Email notifications for contact form submissions (optional)
# Leave empty to skip sending emails (submissions are still stored in DB).
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="HAPR Visual <onboarding@resend.dev>"
CONTACT_TO_EMAIL="haprvisual@gmail.com"

# Object storage for admin image uploads (optional — Cloudflare R2)
# Leave empty to store uploads locally in /public/uploads.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""